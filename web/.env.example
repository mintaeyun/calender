# 복사해서 web/.env.local 로 저장한다. 서비스 롤 키는 절대 넣지 않는다(NEXT_PUBLIC_* 는 브라우저에 노출됨).
# 로컬: supabase start 가 출력하는 API URL / 공개 키. 클라우드: 프로젝트 설정 > API.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# 새 방식 publishable 키(sb_publishable_…). 기존 anon 키는 NEXT_PUBLIC_SUPABASE_ANON_KEY 로 넣어도 폴백으로 동작한다.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
